@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="mb-3">
                    Dịch Vụ Sửa Chữa Nhà<br />
                    <span class="text-warning">Nhanh Gọn - Uy Tín - Tận Nơi</span>
                </h1>
                <p class="mb-4">
                    Nơi bạn đặt niềm tin cho tổ ấm của mình. Sự hài lòng của bạn luôn là mục tiêu phấn đấu của chúng tôi.
                </p>
                <a asp-controller="DichVu" asp-action="Index" class="btn btn-warning btn-lg me-3">
                    <i class="bi bi-grid-fill me-2"></i>Xem dịch vụ
                </a>
                @if (!User.Identity!.IsAuthenticated)
                {
                    <a asp-controller="TaiKhoan" asp-action="DangKy" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-person-plus me-2"></i>Đăng ký miễn phí
                    </a>
                }
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-house-gear" style="font-size: 8rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</section>

<!-- CÁCH THỨC HOẠT ĐỘNG -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-md-4">
                <div class="p-3">
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-2"
                         style="width:50px;height:50px;">
                        <i class="bi bi-search fs-5"></i>
                    </div>
                    <h6 class="fw-semibold">1. Tìm dịch vụ</h6>
                    <p class="text-muted small mb-0">Chọn loại dịch vụ phù hợp nhu cầu</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center mb-2"
                         style="width:50px;height:50px;">
                        <i class="bi bi-calendar-check fs-5"></i>
                    </div>
                    <h6 class="fw-semibold">2. Đặt lịch</h6>
                    <p class="text-muted small mb-0">Chọn ngày giờ, điền địa chỉ và xác nhận</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-2"
                         style="width:50px;height:50px;">
                        <i class="bi bi-tools fs-5"></i>
                    </div>
                    <h6 class="fw-semibold">3. Thợ đến tận nơi</h6>
                    <p class="text-muted small mb-0">Thợ lành nghề - đúng hẹn - hoàn thành tốt công việc</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DANH MỤC DỊCH VỤ -->
<section class="py-5">
    <div class="container">
        <h2 class="section-title">Danh Mục Dịch Vụ</h2>
        <div class="section-divider"></div>

        @if (ViewBag.DanhMuc != null && ((IEnumerable<DatDichVuSuaChuaNhaCua.Models.DanhMuc>)ViewBag.DanhMuc).Any())
        {
            <div class="row g-3">
                @foreach (var cat in (IEnumerable<DatDichVuSuaChuaNhaCua.Models.DanhMuc>)ViewBag.DanhMuc)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <a class="category-card"
                           asp-controller="DichVu" asp-action="Index"
                           asp-route-MaDanhMuc="@cat.MaDanhMuc">
                            <i class="bi @cat.LopBieuTuong"></i>
                            <span>@cat.TenDanhMuc</span>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted">Chưa có danh mục nào. Admin hãy thêm danh mục!</p>
        }
    </div>
</section>

<!-- DỊCH VỤ NỔI BẬT -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h2 class="section-title mb-0">Dịch Vụ Nổi Bật</h2>
            <a asp-controller="DichVu" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="section-divider"></div>

        @if (ViewBag.DichVuMoi != null && ((IEnumerable<DatDichVuSuaChuaNhaCua.Models.DichVu>)ViewBag.DichVuMoi).Any())
        {
            <div class="row g-4">
                @foreach (var svc in (IEnumerable<DatDichVuSuaChuaNhaCua.Models.DichVu>)ViewBag.DichVuMoi)
                {
                    <div class="col-sm-6 col-md-4 col-lg-4">
                        <div class="card service-card h-100">
                            @if (!string.IsNullOrEmpty(svc.HinhAnh))
                            {
                                <img src="@svc.HinhAnh" class="card-img-top" alt="@svc.TenDichVu" />
                            }
                            else
                            {
                                <div class="service-img-placeholder">
                                    <i class="bi bi-tools"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-light text-primary border border-primary mb-2" style="width:fit-content;">
                                    @svc.DanhMuc?.TenDanhMuc
                                </span>
                                <h5 class="card-title">@svc.TenDichVu</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    @(svc.MoTa?.Length > 80 ? svc.MoTa.Substring(0, 80) + "..." : svc.MoTa)
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="price-badge">@svc.GiaTien.ToString("N0") đ</span>
                                    <a asp-controller="DichVu" asp-action="ChiTiet" asp-route-id="@svc.MaDichVu"
                                       class="btn btn-outline-primary btn-sm">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;"></i>
                <p class="mt-2">Chưa có dịch vụ nào. Admin hãy thêm dịch vụ!</p>
            </div>
        }
    </div>
</section>



