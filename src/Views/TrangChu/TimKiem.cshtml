@{
    ViewData["Title"] = "Tìm kiếm: " + ViewBag.TuKhoa;
}
@model IEnumerable<DatDichVuSuaChuaNhaCua.Models.DichVu>

<div class="container py-4">
    <h4 class="mb-1">Kết quả tìm kiếm cho: <strong>"@ViewBag.TuKhoa"</strong></h4>
    <p class="text-muted">Tìm thấy @ViewBag.Count kết quả</p>
    <hr />

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var svc in Model)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card service-card h-100">
                        @if (!string.IsNullOrEmpty(svc.HinhAnh))
                        {
                            <img src="@svc.HinhAnh" class="card-img-top" alt="@svc.TenDichVu" />
                        }
                        else
                        {
                            <div class="service-img-placeholder">
                                <i class="bi bi-tools"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-light text-primary border border-primary mb-2" style="width:fit-content;">
                                @svc.DanhMuc?.TenDanhMuc
                            </span>
                            <h5 class="card-title">@svc.TenDichVu</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(svc.MoTa?.Length > 80 ? svc.MoTa.Substring(0, 80) + "..." : svc.MoTa)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="price-badge">@svc.GiaTien.ToString("N0") đ</span>
                                <a asp-controller="DichVu" asp-action="ChiTiet" asp-route-id="@svc.MaDichVu"
                                   class="btn btn-outline-primary btn-sm">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search text-muted" style="font-size:4rem;"></i>
            <h5 class="mt-3 text-muted">Không tìm thấy dịch vụ, chúng tôi sẽ sớm cập nhật, bạn vui lòng chọn dịch vụ khác nhé</h5>
            <a asp-controller="DichVu" asp-action="Index" class="btn btn-primary mt-2">
                Xem tất cả dịch vụ
            </a>
        </div>
    }
</div>



