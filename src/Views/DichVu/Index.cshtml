@{
    ViewData["Title"] = "Danh Sách Dịch Vụ";
}
@model IEnumerable<DatDichVuSuaChuaNhaCua.Models.DichVu>

<!-- Breadcrumb -->
<div class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="TrangChu" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Dịch vụ</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4">
    <h2 class="section-title">Tất Cả Dịch Vụ</h2>
    <div class="section-divider"></div>

    <!-- Lọc theo danh mục -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm @(ViewBag.MaDanhMucDaChonId == null ? "btn-primary" : "btn-outline-primary") me-2 mb-2">
            Tất cả
        </a>
        @foreach (var cat in (IEnumerable<DatDichVuSuaChuaNhaCua.Models.DanhMuc>)ViewBag.DanhMuc)
        {
            <a asp-action="Index" asp-route-MaDanhMuc="@cat.MaDanhMuc"
               class="btn btn-sm @(ViewBag.MaDanhMucDaChonId == cat.MaDanhMuc ? "btn-primary" : "btn-outline-primary") me-2 mb-2">
                <i class="bi @cat.LopBieuTuong me-1"></i>@cat.TenDanhMuc
            </a>
        }
    </div>

    <!-- Danh sách dịch vụ -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var svc in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card service-card h-100">
                        @if (!string.IsNullOrEmpty(svc.HinhAnh))
                        {
                            <img src="@svc.HinhAnh" class="card-img-top" alt="@svc.TenDichVu" />
                        }
                        else
                        {
                            <div class="service-img-placeholder">
                                <i class="bi @(svc.DanhMuc?.LopBieuTuong ?? "bi-tools")"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-light text-primary border border-primary mb-2" style="width:fit-content;">
                                <i class="bi @svc.DanhMuc?.LopBieuTuong me-1"></i>@svc.DanhMuc?.TenDanhMuc
                            </span>
                            <h5 class="card-title">@svc.TenDichVu</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(svc.MoTa?.Length > 90 ? svc.MoTa.Substring(0, 90) + "..." : svc.MoTa)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <span class="price-badge">@svc.GiaTien.ToString("N0") đ</span>
                                    <small class="text-muted ms-2">
                                        <i class="bi bi-clock me-1"></i>~@svc.ThoiGian phút
                                    </small>
                                </div>
                                <a asp-controller="DichVu" asp-action="ChiTiet" asp-route-id="@svc.MaDichVu"
                                   class="btn btn-primary btn-sm">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size:4rem;"></i>
            <h5 class="mt-3 text-muted">Dich vụ sẽ sớm được cập nhật, bạn vui lòng quay lại sau nhé.</h5>
            <a asp-action="Index" class="btn btn-primary mt-2">Xem tất cả dịch vụ</a>
        </div>
    }
</div>



