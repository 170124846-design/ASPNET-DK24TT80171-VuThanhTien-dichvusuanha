@{
    ViewData["Title"] = "Đơn Đặt Lịch Của Tôi";
}
@model IEnumerable<DatDichVuSuaChuaNhaCua.Models.DonDatLich>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="section-title mb-0">Đơn Đặt Lịch Của Tôi</h2>
            <div class="section-divider mt-2"></div>
        </div>
        <a asp-controller="DichVu" asp-action="Index" class="btn btn-warning">
            <i class="bi bi-plus-circle me-1"></i>Đặt thêm dịch vụ
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var don in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:45px;height:45px;">
                                            <i class="bi bi-tools"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">@don.DichVu?.TenDichVu</h6>
                                            <small class="text-muted">
                                                <i class="bi bi-tag me-1"></i>@don.DichVu?.DanhMuc?.TenDanhMuc
                                            </small><br />
                                            <small class="text-muted">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @don.NgayHen.ToString("dd/MM/yyyy") - @don.KhungGio
                                            </small><br />
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>@don.DiaChi
                                            </small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 text-md-center mt-3 mt-md-0">
                                    <div class="text-muted small">Tổng tiền</div>
                                    <div class="fw-bold text-warning fs-5">@don.TongTien.ToString("N0") đ</div>
                                    <div class="text-muted small">Đặt lúc: @don.NgayTao.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-md-3 text-md-end mt-3 mt-md-0">
                                    <!-- Trạng thái đơn -->
                                    <span class="status-badge status-@don.TrangThai d-block mb-2">
                                        @GetStatusLabel(don.TrangThai)
                                    </span>
                                    <small class="text-muted d-block mb-2">Mã đơn: #@don.MaDon</small>

                                    <!-- Nút hủy (chỉ khi Pending) -->
                                    @if (don.TrangThai == "Pending")
                                    {
                                        <form asp-action="HuyDon" asp-route-id="@don.MaDon" method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn hủy đơn này?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-x-circle me-1"></i>Hủy đơn
                                            </button>
                                        </form>
                                    }
                                    <!-- Nút Đánh giá và Hiển thị Đánh giá (chỉ khi Completed) -->
                                    @if (don.TrangThai == "Completed")
                                    {
                                        if (don.DanhGias != null && don.DanhGias.Any())
                                        {
                                            var dg = don.DanhGias.First();
                                            <div class="mt-2 p-2 bg-light rounded border border-warning text-start">
                                                <span class="text-warning d-block mb-1">
                                                    @for (int i = 0; i < dg.SoSao; i++)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                </span>
                                                <small class="d-block text-muted fst-italic">"@dg.BinhLuan"</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <a asp-controller="DatLich" asp-action="ThemDanhGia" asp-route-maDon="@don.MaDon" class="btn btn-warning btn-sm mt-2 w-100">
                                                <i class="bi bi-star-fill me-1"></i>Đánh giá dịch vụ
                                            </a>
                                        }
                                    }

                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(don.GhiChu))
                            {
                                <hr class="my-2" />
                                <small class="text-muted">
                                    <i class="bi bi-chat-left-text me-1"></i>Ghi chú: @don.GhiChu
                                </small>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size:4rem;"></i>
            <h5 class="mt-3 text-muted">Bạn chưa có đơn đặt lịch nào</h5>
            <a asp-controller="DichVu" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-search me-1"></i>Tìm dịch vụ ngay
            </a>
        </div>
    }
</div>

@functions {
    string GetStatusLabel(string status) => status switch
    {
        "Pending" => "⏳ Chờ xác nhận",
        "Confirmed" => "✅ Đã xác nhận",
        "InProgress" => "🔧 Đang thực hiện",
        "Completed" => "✔️ Hoàn thành",
        "Cancelled" => "❌ Đã hủy",
        _ => status
    };
}



