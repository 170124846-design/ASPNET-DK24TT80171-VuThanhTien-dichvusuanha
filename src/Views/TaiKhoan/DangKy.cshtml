@{
    ViewData["Title"] = "Đăng ký tài khoản";
}
@model DatDichVuSuaChuaNhaCua.Models.ViewModels.RegisterViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Đăng ký tài khoản</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="DangKy" method="post">
                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" />
                            </div>
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Ít nhất 6 ký tự" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="XacNhanMatKhau" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="XacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu" />
                            </div>
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-check me-2"></i>Tạo tài khoản
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center text-muted small py-3">
                    Đã có tài khoản?
                    <a asp-action="DangNhap" class="text-primary fw-semibold">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>



