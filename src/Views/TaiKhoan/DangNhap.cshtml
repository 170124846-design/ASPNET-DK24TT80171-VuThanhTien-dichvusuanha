@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}
@model DatDichVuSuaChuaNhaCua.Models.ViewModels.LoginViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="DangNhap" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>
                        }
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                            <label asp-for="RememberMe" class="form-check-label">Nhớ đăng nhập</label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center text-muted small py-3">
                    Chưa có tài khoản?
                    <a asp-action="DangKy" class="text-primary fw-semibold">Đăng ký ngay</a>
                </div>
            </div>

            <!-- Tài khoản demo -->
            <div class="alert alert-info mt-3 small">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Demo:</strong><br />
                Admin: <code>tienvt@admin.vn</code> / <code>tien123</code><br />
                Khách: <code>khach@demo.vn</code> / <code>khach123</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị validation summary nếu có lỗi
        var summary = document.querySelector('[data-valmsg-summary]');
        if (summary && summary.querySelector('li')) {
            summary.closest('.alert').style.display = 'block';
        }
    </script>
}



