@{
    ViewData["Title"] = "Quản Lý Danh Mục";
    Layout = "_AdminLayout";
}
@model IEnumerable<DatDichVuSuaChuaNhaCua.Models.DanhMuc>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0">Tổng: <strong>@Model.Count()</strong> danh mục</h6>
    <a asp-action="ThemDanhMuc" class="btn btn-warning">
        <i class="bi bi-plus-circle me-1"></i>Thêm danh mục
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Icon</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.MaDanhMuc</td>
                        <td><i class="bi @cat.LopBieuTuong fs-4 text-primary"></i></td>
                        <td class="fw-semibold">@cat.TenDanhMuc</td>
                        <td><small class="text-muted">@cat.MoTa</small></td>
                        <td>
                            @if (cat.DangHoatDong)
                            {
                                <span class="badge bg-success">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ẩn</span>
                            }
                        </td>
                        <td>
                            <a asp-action="SuaDanhMuc" asp-route-id="@cat.MaDanhMuc"
                               class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="XoaDanhMuc" asp-route-id="@cat.MaDanhMuc"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa danh mục này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>



