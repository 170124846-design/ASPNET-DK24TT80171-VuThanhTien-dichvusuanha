{
  "ConnectionStrings": {
    // Kết nối tới SQL Server Developer trên máy local
    // Server=. nghĩa là dùng SQL Server mặc định trên máy tính này
    // Trusted_Connection=True nghĩa là dùng Windows Authentication (không cần user/pass)
    "DefaultConnection": "Server=.;Database=DatDichVuSuaChuaNhaCua;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

